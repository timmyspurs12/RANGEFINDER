diff --git a/src/server/routes/scheduler.ts b/src/server/routes/scheduler.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d26717a9f2fc81aefa11eb467e93f0bce063d328
--- /dev/null
+++ b/src/server/routes/scheduler.ts
@@ -0,0 +1,51 @@
+// Scheduled daily post (Stage 3.7 phase B). Registered in devvit.json:
+//
+//   "scheduler": {
+//     "tasks": {
+//       "daily-post": { "endpoint": "/internal/scheduler/daily-post", "cron": "5 0 * * *" }
+//     }
+//   }
+//
+// The platform POSTs a TaskRequest {name, data} (per @devvit/scheduler
+// typings) to this endpoint at 00:05 UTC every day. The canonical UTC day is
+// computed from the server clock at execution time — the request body is
+// parsed for logging only and is NEVER trusted for the day or the challenge.
+// Idempotency lives in ensureDailyPostForUtcDay(): repeated deliveries,
+// crashes and racing moderator actions can never create a second post.
+import { Hono } from 'hono';
+import { utcDayKey } from '../../shared/dayKey';
+import { ensureDailyPostForUtcDay } from '../core/dailyPost';
+
+export const scheduler = new Hono();
+
+scheduler.post('/daily-post', async (c) => {
+  // Log-only parse of the TaskRequest body (never trusted for scheduling input).
+  let bodyName = 'unknown';
+  try {
+    const body = await c.req.json<{ name?: string }>();
+    bodyName = typeof body?.name === 'string' ? body.name : 'unknown';
+  } catch {
+    // no/invalid body — the scheduled task contract does not require one
+  }
+
+  const utcDay = utcDayKey();
+  console.log(
+    `[rangefinder:dailypost] scheduler task "${bodyName}" firing for UTC day ${utcDay}`
+  );
+
+  try {
+    const result = await ensureDailyPostForUtcDay(utcDay, { reason: 'scheduler' });
+    console.log(
+      `[rangefinder:dailypost] scheduler outcome for ${utcDay}: ${result.status}` +
+        (result.postId ? ` post=${result.postId}` : '') +
+        ` challenge=${result.challengeId}` +
+        (result.message ? ` (${result.message})` : '')
+    );
+    // TaskResponse is currently an empty object per the typings.
+    return c.json({}, 200);
+  } catch (error) {
+    console.error(`[rangefinder:dailypost] unexpected scheduler failure:`, error);
+    // A 500 asks the platform to redeliver; redelivery is idempotent by design.
+    return c.json({}, 500);
+  }
+});

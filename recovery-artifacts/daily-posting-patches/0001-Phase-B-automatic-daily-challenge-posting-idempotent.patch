+// Daily-post idempotency (Stage 3.7 — daily posting phase B).
+//
+// One post maximum per subreddit installation and UTC day. BOTH the
+// devvit.json-scheduled task (/internal/scheduler/daily-post) and the
+// moderator menu fallback (/internal/menu/post-create) call the SAME function:
+// ensureDailyPostForUtcDay(). The on-app-install trigger also routes through
+// it so an installation never ends up with two different day-X posts.
+//
+// IDEMPOTENCY DESIGN (honest scope):
+// • Claim: Redis key `rf:dailypost:{subredditId}:{utcDay}` claimed with
+//   SET(NX) + TTL — an atomic single-step claim; concurrent scheduled and
+//   manual callers cannot both create (the loser re-reads and never creates).
+// • The claim value persists the postId immediately after Reddit accepts the
+//   submission; a repeat delivery then returns the existing post.
+// • FAILURE WINDOW: a crash between Reddit accepting the post and the postId
+//   persistence leaves a claim with no postId. This implementation is
+//   therefore AT-MOST-ONCE, not exactly-once. Recovery is best-effort:
+//   (a) orphan adoption — the claim owner's recent posts (app account) are
+//       enumerated and one carrying the day's challengeId is adopted;
+//   (b) stale-claim retry — a postId-less claim older than STALE_MS is
+//       treated as dead and a replacement is created.
+//   If the orphaned post was created but cannot be found by (a), the retry in
+//   (b) creates a duplicate post. Cosmetic only — player-result idempotency
+//   keys on `challenge:{id}` are post-independent, so scoring and daily stats
+//   can never double-count across duplicate posts. Not hidden: callers log
+//   every outcome and docs/PLAYTEST-RUNBOOK.md documents the window.
+
+import { context, redis, reddit } from '@devvit/web/server';
+import { scheduledChallengeIdFor } from '../challenge.ts';
+import { createPost } from './post.ts';
+
+export const DAILY_POST_TITLE = 'Rangefinder — can you estimate reality?';
+
+/** Claim TTL: covers the day plus a manual retry window (2 days). */
+export const DAILY_POST_CLAIM_TTL_SECONDS = 48 * 3600;
+/**
+ * A postId-less claim older than this is treated as dead (the creating run
+ * crashed). Short enough for same-day recovery, long enough that a merely
+ * slow run is never double-created.
+ */
+export const DAILY_POST_STALE_MS = 15 * 60 * 1000;
+
+export type DailyPostStatus =
+  | 'created' // this call submitted the post
+  | 'exists' // a post for the day already exists (created earlier)
+  | 'in-progress' // another run holds a fresh claim; no postId yet
+  | 'unreachable' // a recorded postId exists but Reddit cannot serve it
+  | 'invalid-day' // utcDay argument malformed
+  | 'error'; // post creation failed; claim released for retry
+
+export type DailyPostResult = {
+  status: DailyPostStatus;
+  /** The day's post id when known (null while in-progress/failed). */
+  postId: string | null;
+  /** The challenge scheduled for the day (empty for invalid-day). */
+  challengeId: string;
+  message?: string;
+};
+
+export type DailyPostLike = {
+  id: string;
+  getPostData(): Promise<{ challengeId?: unknown } | undefined>;
+};
+
+export interface DailyPostDeps {
+  redis: {
+    get(key: string): Promise<string | undefined>;
+    set(
+      key: string,
+      value: string,
+      options?: { nx?: boolean; expiration?: Date }
+    ): Promise<unknown>;
+    del(key: string): Promise<unknown>;
+  };
+  reddit: {
+    submitCustomPost(opts: {
+      title: string;
+      postData: { challengeId: string; v: number };
+    }): Promise<{ id: string }>;
+    getPostById(id: string): Promise<DailyPostLike>;
+    /** Optional: only used for orphan adoption in the crash window. */
+    getPostsByUser?(opts: {
+      username: string;
+      sort?: 'new';
+      timeframe?: 'day' | 'week';
+      limit?: number;
+    }): Promise<{ all(): Promise<DailyPostLike[]> }>;
+  };
+  /** Installation namespace for the claim key (subreddit id preferred). */
+  namespace: string;
+  /** App account username used to enumerate orphan posts (adoption path). */
+  appUsername: string;
+}
+
+/** Production deps from the ambient Devvit server clients. */
+function defaultDeps(): DailyPostDeps {
+  return {
+    redis,
+    reddit: reddit as unknown as DailyPostDeps['reddit'],
+    namespace: context.subredditId || context.subredditName || 'unknown',
+    appUsername: context.appSlug || context.appName,
+  };
+}
+
+type Claim = { challengeId: string; postId: string | null; at: number };
+
+function parseClaim(raw: string): Claim | null {
+  try {
+    const parsed = JSON.parse(raw) as Partial<Claim>;
+    if (
+      typeof parsed.challengeId !== 'string' ||
+      typeof parsed.at !== 'number' ||
+      !(parsed.postId === null || typeof parsed.postId === 'string')
+    ) {
+      return null;
+    }
+    return parsed as Claim;
+  } catch {
+    return null;
+  }
+}
+
+export function dailyPostClaimKey(namespace: string, utcDay: string): string {
+  return `rf:dailypost:${namespace}:${utcDay}`;
+}
+
+/** The production Redis client resolves SET NX to 'OK' or an empty result. */
+function claimSucceeded(setResponse: unknown): boolean {
+  return setResponse === 'OK' || setResponse === true || setResponse === 1;
+}
+
+export type EnsureOptions = {
+  /** Why the call was made — logging only; never affects the outcome. */
+  reason?: 'scheduler' | 'menu' | 'install';
+  now?: number;
+  deps?: DailyPostDeps;
+};
+
+/**
+ * Ensure exactly one Rangefinder challenge post exists for `utcDay`
+ * (format YYYY-MM-DD, UTC). Returns the existing post when one is recorded;
+ * creates one only when no live claim or recorded post stands in the way.
+ */
+export async function ensureDailyPostForUtcDay(
+  utcDay: string,
+  opts: EnsureOptions = {}
+): Promise<DailyPostResult> {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(utcDay)) {
+    return {
+      status: 'invalid-day',
+      postId: null,
+      challengeId: '',
+      message: `utcDay must be YYYY-MM-DD (UTC), got ${JSON.stringify(utcDay)}`,
+    };
+  }
+  const deps = opts.deps ?? defaultDeps();
+  const now = opts.now ?? Date.now();
+  const challengeId = scheduledChallengeIdFor(utcDay);
+  const key = dailyPostClaimKey(deps.namespace, utcDay);
+  const reason = opts.reason ?? 'scheduler';
+
+  for (let attempt = 0; attempt < 2; attempt++) {
+    const raw = await deps.redis.get(key);
+    if (typeof raw === 'string' && raw.length > 0) {
+      const existing = await handleExistingClaim(deps, key, raw, challengeId, now, reason);
+      if (existing !== null) return existing;
+      // null = the claim was stale/corrupt and has been released — loop to claim.
+      continue;
+    }
+
+    // Atomic single-step claim: only ONE concurrent caller wins.
+    const claim = JSON.stringify({ challengeId, postId: null, at: now } satisfies Claim);
+    const setResponse = await deps.redis.set(key, claim, {
+      nx: true,
+      expiration: new Date(now + DAILY_POST_CLAIM_TTL_SECONDS * 1000),
+    });
+    if (!claimSucceeded(setResponse)) {
+      continue; // lost the race — re-read the winner's claim once
+    }
+
+    try {
+      const post = await createPost(challengeId, deps.reddit.submitCustomPost.bind(deps.reddit));
+      await deps.redis.set(
+        key,
+        JSON.stringify({ challengeId, postId: post.id, at: now } satisfies Claim),
+        { expiration: new Date(now + DAILY_POST_CLAIM_TTL_SECONDS * 1000) }
+      );
+      console.log(
+        `[rangefinder:dailypost] ${reason} created post ${post.id} for ${utcDay} (challenge ${challengeId}) in ${deps.namespace}`
+      );
+      return { status: 'created', postId: post.id, challengeId };
+    } catch (error) {
+      // Release the claim so any later run can retry creation.
+      await deps.redis.del(key).catch(() => undefined);
+      const message = error instanceof Error ? error.message : String(error);
+      console.error(
+        `[rangefinder:dailypost] ${reason} post creation FAILED for ${utcDay} (${challengeId}): ${message} — claim released`
+      );
+      return { status: 'error', postId: null, challengeId, message };
+    }
+  }
+
+  // Both attempts lost the race to a fresh claim.
+  return {
+    status: 'in-progress',
+    postId: null,
+    challengeId,
+    message: 'Another run is creating today’s post; retry shortly to retrieve it.',
+  };
+}
+
+/** Returns a result, or null when the claim is dead/corrupt and was released. */
+async function handleExistingClaim(
+  deps: DailyPostDeps,
+  key: string,
+  raw: string,
+  challengeId: string,
+  now: number,
+  reason: EnsureOptions['reason']
+): Promise<DailyPostResult | null> {
+  const parsed = parseClaim(raw);
+  if (!parsed || parsed.challengeId !== challengeId) {
+    console.warn(
+      `[rangefinder:dailypost] corrupt/mismatched claim at ${key} (${raw.slice(0, 120)}) — releasing for recovery`
+    );
+    await deps.redis.del(key).catch(() => undefined);
+    return null;
+  }
+  if (parsed.postId) {
+    return verifyRecordedPost(deps, parsed.postId, challengeId);
+  }
+  const age = now - parsed.at;
+  if (age < DAILY_POST_STALE_MS) {
+    return {
+      status: 'in-progress',
+      postId: null,
+      challengeId,
+      message: 'Post creation is already in progress.',
+    };
+  }
+  // Stale postId-less claim: the creating run died. Try to adopt the orphan,
+  // otherwise release the claim and create a replacement (at-most-once).
+  const adopted = await tryAdoptOrphan(deps, challengeId, reason);
+  if (adopted !== null) {
+    await deps.redis.set(
+      key,
+      JSON.stringify({ challengeId, postId: adopted, at: parsed.at } satisfies Claim),
+      { expiration: new Date(now + DAILY_POST_CLAIM_TTL_SECONDS * 1000) }
+    );
+    return { status: 'exists', postId: adopted, challengeId };
+  }
+  console.warn(
+    `[rangefinder:dailypost] stale postId-less claim for challenge ${challengeId} released — a replacement post may duplicate an orphaned one (documented at-most-once limitation)`
+  );
+  await deps.redis.del(key).catch(() => undefined);
+  return null;
+}
+
+/** Reconcile a recorded postId against Reddit (supported API: getPostById). */
+async function verifyRecordedPost(
+  deps: DailyPostDeps,
+  postId: string,
+  challengeId: string
+): Promise<DailyPostResult> {
+  try {
+    const post = await deps.reddit.getPostById(postId);
+    if (!post || typeof post.id !== 'string') throw new Error('malformed post response');
+    return { status: 'exists', postId, challengeId };
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    console.warn(
+      `[rangefinder:dailypost] recorded post ${postId} is unreachable (${message}) — NOT recreating automatically`
+    );
+    return {
+      status: 'unreachable',
+      postId,
+      challengeId,
+      message:
+        'Today’s post record exists but the post is unreachable (deleted or removed). No replacement was created; wait for the claim to expire or investigate manually.',
+    };
+  }
+}
+
+/**
+ * Crash-window recovery: enumerate the app account's recent posts and adopt
+ * one carrying the day's challengeId. Best effort — returns null when the
+ * enumeration API is unavailable, fails, or finds nothing.
+ */
+async function tryAdoptOrphan(
+  deps: DailyPostDeps,
+  challengeId: string,
+  reason: EnsureOptions['reason']
+): Promise<string | null> {
+  if (!deps.reddit.getPostsByUser) return null;
+  try {
+    const listing = await deps.reddit.getPostsByUser({
+      username: deps.appUsername,
+      sort: 'new',
+      timeframe: 'week',
+      limit: 25,
+    });
+    const posts = await listing.all();
+    for (const post of posts) {
+      try {
+        const data = await post.getPostData();
+        if (data && data.challengeId === challengeId) {
+          console.log(
+            `[rangefinder:dailypost] ${reason} adopted orphan post ${post.id} for challenge ${challengeId} (crash-window recovery)`
+          );
+          return post.id;
+        }
+      } catch {
+        // Unreadable post data — skip this candidate.
+      }
+    }
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    console.warn(
+      `[rangefinder:dailypost] orphan adoption unavailable (getPostsByUser as u/${deps.appUsername}): ${message}`
+    );
+  }
+  return null;
+}
+
+export { createPost };

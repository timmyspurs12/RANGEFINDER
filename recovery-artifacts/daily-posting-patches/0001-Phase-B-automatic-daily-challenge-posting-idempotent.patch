diff --git a/src/server/dailyPost.test.ts b/src/server/dailyPost.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..56d24c8baba4553dc55c0dc7a1936db34f5d952a
--- /dev/null
+++ b/src/server/dailyPost.test.ts
@@ -0,0 +1,336 @@
+// Unit tests for the shared idempotent daily-post module (Stage 3.7 phase B).
+//
+// HONEST SCOPE NOTE (same as store.test.ts): these tests exercise the claim,
+// recovery and dedup logic against faithful in-memory mocks. They are NOT
+// live-Redis/live-Reddit proof — live behaviour is verified in playtest
+// (docs/PLAYTEST-RUNBOOK.md). The atomicity of the NX claim itself must be
+// confirmed against real Redis during the playtest milestone.
+//
+// Run: npm run test:unit
+
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+import {
+  DAILY_POST_CLAIM_TTL_SECONDS,
+  DAILY_POST_STALE_MS,
+  dailyPostClaimKey,
+  ensureDailyPostForUtcDay,
+} from './core/dailyPost.ts';
+import type { DailyPostDeps, DailyPostLike } from './core/dailyPost.ts';
+import { scheduledChallengeIdFor } from './challenge.ts';
+
+const NS = 't5_testsub';
+const APP = 'rangefinder-test';
+const DAY0 = '2026-11-26'; // rotation epoch → earth-circumference-v1
+const DAY1 = '2026-11-27'; // → burj-khalifa-height-v1
+const NOW = Date.UTC(2026, 10, 26, 0, 5, 0); // 2026-11-26 00:05:00 UTC
+
+class MockRedis {
+  strings = new Map<string, string>();
+  expiries = new Map<string, number>();
+  /** When true, SET NX always fails (simulates losing an atomic race). */
+  blockNx = false;
+
+  async get(key: string): Promise<string | undefined> {
+    return this.strings.get(key);
+  }
+  async set(
+    key: string,
+    value: string,
+    options?: { nx?: boolean; expiration?: Date }
+  ): Promise<unknown> {
+    if (options?.nx && (this.strings.has(key) || this.blockNx)) return undefined;
+    this.strings.set(key, value);
+    if (options?.expiration) this.expiries.set(key, options.expiration.getTime());
+    return 'OK';
+  }
+  async del(key: string): Promise<unknown> {
+    return this.strings.delete(key) ? 1 : 0;
+  }
+}
+
+class MockReddit {
+  /** Captured submitCustomPost calls (opts + assigned id). */
+  submits: Array<{ title: string; postData: { challengeId: string; v: number } }> = [];
+  posts = new Map<string, { challengeId: string }>();
+  /** When set, getPostById throws for every id (simulates unreachable). */
+  failGetPostById = false;
+  /** Orphans visible to getPostsByUser (username filter honoured). */
+  visibleToUser: string | null = APP;
+  nextId = 1;
+
+  async submitCustomPost(opts: {
+    title: string;
+    postData: { challengeId: string; v: number };
+  }): Promise<{ id: string }> {
+    this.submits.push(opts);
+    const id = `t3_${this.nextId++}`;
+    this.posts.set(id, { challengeId: opts.postData.challengeId });
+    return { id };
+  }
+
+  async getPostById(id: string): Promise<DailyPostLike> {
+    if (this.failGetPostById) throw new Error('post not found (mock)');
+    const post = this.posts.get(id);
+    if (!post) throw new Error('post not found (mock)');
+    return {
+      id,
+      getPostData: async () => ({ challengeId: post.challengeId }),
+    };
+  }
+
+  getPostsByUser(opts: {
+    username: string;
+    sort?: 'new';
+    timeframe?: 'day' | 'week';
+    limit?: number;
+  }): { all(): Promise<DailyPostLike[]> } {
+    return {
+      all: async () => {
+        if (this.visibleToUser !== opts.username) {
+          throw new Error(`redditor ${opts.username} not found (mock)`);
+        }
+        return [...this.posts.entries()].map(([id, post]) => ({
+          id,
+          getPostData: async () => ({ challengeId: post.challengeId }),
+        }));
+      },
+    };
+  }
+}
+
+function makeDeps(opts?: { reddit?: MockReddit; redis?: MockRedis }): DailyPostDeps & {
+  redditMock: MockReddit;
+  redisMock: MockRedis;
+} {
+  const redisMock = opts?.redis ?? new MockRedis();
+  const redditMock = opts?.reddit ?? new MockReddit();
+  const deps: DailyPostDeps = {
+    redis: redisMock as unknown as DailyPostDeps['redis'],
+    reddit: redditMock as unknown as DailyPostDeps['reddit'],
+    namespace: NS,
+    appUsername: APP,
+  };
+  return { ...deps, redditMock, redisMock } as DailyPostDeps & {
+    redditMock: MockReddit;
+    redisMock: MockRedis;
+  };
+}
+
+test('invalid utcDay format is rejected before any Redis or Reddit call', async () => {
+  const { redditMock } = makeDeps();
+  const result = await ensureDailyPostForUtcDay('nov 26', {
+    deps: mkDeps(redditMock),
+    now: NOW,
+  });
+  assert.equal(result.status, 'invalid-day');
+  assert.equal(result.postId, null);
+  assert.equal(redditMock.submits.length, 0);
+});
+
+// helper bridging the mock pair into the deps type
+function mkDeps(redditMock: MockReddit, redisMock?: MockRedis): DailyPostDeps {
+  return {
+    redis: (redisMock ?? new MockRedis()) as unknown as DailyPostDeps['redis'],
+    reddit: redditMock as unknown as DailyPostDeps['reddit'],
+    namespace: NS,
+    appUsername: APP,
+  };
+}
+
+test('creates the day’s post with the scheduled challenge and posts only public data', async () => {
+  const { redditMock, redisMock } = makeDeps();
+  const result = await ensureDailyPostForUtcDay(DAY0, {
+    deps: mkDeps(redditMock, redisMock),
+    now: NOW,
+  });
+  assert.equal(result.status, 'created');
+  assert.equal(result.postId, 't3_1');
+  assert.equal(result.challengeId, scheduledChallengeIdFor(DAY0));
+  assert.equal(redditMock.submits.length, 1);
+  // postData carries ONLY the challenge id and a version tag — never the answer.
+  assert.deepEqual(redditMock.submits[0]!.postData, {
+    challengeId: 'earth-circumference-v1',
+    v: 1,
+  });
+  // claim persisted with the postId and a TTL
+  const raw = await redisMock.get(dailyPostClaimKey(NS, DAY0));
+  assert.ok(raw);
+  const claim = JSON.parse(raw!) as { challengeId: string; postId: string | null; at: number };
+  assert.equal(claim.postId, 't3_1');
+  assert.equal(claim.challengeId, 'earth-circumference-v1');
+  assert.equal(redisMock.expiries.get(dailyPostClaimKey(NS, DAY0)), NOW + DAILY_POST_CLAIM_TTL_SECONDS * 1000);
+});
+
+test('repeated scheduler delivery returns the existing post — no second submission', async () => {
+  const { redditMock, redisMock } = makeDeps();
+  const deps = mkDeps(redditMock, redisMock);
+  const first = await ensureDailyPostForUtcDay(DAY0, { deps, now: NOW });
+  assert.equal(first.status, 'created');
+  const second = await ensureDailyPostForUtcDay(DAY0, { deps, now: NOW + 60_000 });
+  assert.equal(second.status, 'exists');
+  assert.equal(second.postId, first.postId);
+  assert.equal(redditMock.submits.length, 1); // idempotent
+});
+
+test('scheduled and manual paths share ONE idempotency domain — same result, no duplicate', async () => {
+  const { redditMock, redisMock } = makeDeps();
+  const deps = mkDeps(redditMock, redisMock);
+  const scheduled = await ensureDailyPostForUtcDay(DAY0, { deps, reason: 'scheduler', now: NOW });
+  const manual = await ensureDailyPostForUtcDay(DAY0, { deps, reason: 'menu', now: NOW + 500 });
+  assert.equal(manual.status, 'exists');
+  assert.equal(manual.postId, scheduled.postId);
+  assert.equal(manual.challengeId, scheduled.challengeId);
+  assert.equal(redditMock.submits.length, 1);
+});
+
+test('concurrent runs: a fresh postId-less claim blocks creation (atomic-claim loser)', async () => {
+  const { redditMock, redisMock } = makeDeps();
+  // The "winner" claimed but has not persisted a postId yet.
+  await redisMock.set(
+    dailyPostClaimKey(NS, DAY0),
+    JSON.stringify({ challengeId: 'earth-circumference-v1', postId: null, at: NOW })
+  );
+  const loser = await ensureDailyPostForUtcDay(DAY0, {
+    deps: mkDeps(redditMock, redisMock),
+    now: NOW + 1000, // 1s after the claim — fresh
+  });
+  assert.equal(loser.status, 'in-progress');
+  assert.equal(loser.postId, null);
+  assert.equal(redditMock.submits.length, 0); // never created a second post
+});
+
+test('lost NX race: the caller re-reads the winner and does not create', async () => {
+  const redisMock = new MockRedis();
+  const redditMock = new MockReddit();
+  // The winner already holds a completed claim; the loser reads it before any
+  // NX attempt would be made.
+  redditMock.posts.set('t3_42', { challengeId: 'earth-circumference-v1' });
+  await redisMock.set(
+    dailyPostClaimKey(NS, DAY0),
+    JSON.stringify({ challengeId: 'earth-circumference-v1', postId: 't3_42', at: NOW })
+  );
+  const result = await ensureDailyPostForUtcDay(DAY0, {
+    deps: mkDeps(redditMock, redisMock),
+    now: NOW + 1000,
+  });
+  assert.equal(result.status, 'exists');
+  assert.equal(result.postId, 't3_42');
+  assert.equal(redditMock.submits.length, 0);
+});
+
+test('UTC date boundaries: consecutive days create distinct posts and distinct claims', async () => {
+  const { redditMock, redisMock } = makeDeps();
+  const deps = mkDeps(redditMock, redisMock);
+  const day0 = await ensureDailyPostForUtcDay(DAY0, { deps, now: NOW });
+  const day1 = await ensureDailyPostForUtcDay(DAY1, { deps, now: NOW + 86_400_000 });
+  assert.equal(day0.challengeId, 'earth-circumference-v1');
+  assert.equal(day1.challengeId, 'burj-khalifa-height-v1'); // per verified rotation
+  assert.notEqual(day0.postId, day1.postId);
+  assert.ok(await redisMock.get(dailyPostClaimKey(NS, DAY0)));
+  assert.ok(await redisMock.get(dailyPostClaimKey(NS, DAY1)));
+  assert.equal(redditMock.submits.length, 2);
+  // Same day again → still one post per day.
+  const day1Again = await ensureDailyPostForUtcDay(DAY1, { deps, now: NOW + 90_000_000 });
+  assert.equal(day1Again.status, 'exists');
+  assert.equal(day1Again.postId, day1.postId);
+  assert.equal(redditMock.submits.length, 2);
+});
+
+test('failed creation releases the claim — a later run can retry', async () => {
+  const redisMock = new MockRedis();
+  const redditMock = new MockReddit();
+  // Make the FIRST submission fail.
+  redditMock.submitCustomPost = async (opts) => {
+    throw new Error('simulated submit failure');
+  };
+  const failed = await ensureDailyPostForUtcDay(DAY0, {
+    deps: mkDeps(redditMock, redisMock),
+    now: NOW,
+  });
+  assert.equal(failed.status, 'error');
+  assert.equal(failed.postId, null);
+  assert.equal(await redisMock.get(dailyPostClaimKey(NS, DAY0)), undefined); // released
+  // Recovery: a working client creates the post on the next call.
+  const working = new MockReddit();
+  const recovered = await ensureDailyPostForUtcDay(DAY0, {
+    deps: mkDeps(working, redisMock),
+    now: NOW + 30_000,
+  });
+  assert.equal(recovered.status, 'created');
+  assert.equal(recovered.postId, 't3_1');
+});
+
+test('stale claim + enumeration finds the orphan → adopted, no duplicate', async () => {
+  const redisMock = new MockRedis();
+  const redditMock = new MockReddit();
+  // Crash window: the orphan post WAS created but the claim never got the id.
+  redditMock.posts.set('t3_orphan', { challengeId: 'earth-circumference-v1' });
+  await redisMock.set(
+    dailyPostClaimKey(NS, DAY0),
+    JSON.stringify({ challengeId: 'earth-circumference-v1', postId: null, at: NOW - DAILY_POST_STALE_MS - 1000 })
+  );
+  const result = await ensureDailyPostForUtcDay(DAY0, {
+    deps: mkDeps(redditMock, redisMock),
+    now: NOW,
+  });
+  assert.equal(result.status, 'exists');
+  assert.equal(result.postId, 't3_orphan');
+  assert.equal(redditMock.submits.length, 0); // adopted, not recreated
+  const claim = JSON.parse((await redisMock.get(dailyPostClaimKey(NS, DAY0)))!) as { postId: string };
+  assert.equal(claim.postId, 't3_orphan');
+});
+
+test('stale claim + unavailable enumeration → replacement created (documented at-most-once)', async () => {
+  const redisMock = new MockRedis();
+  const redditMock = new MockReddit();
+  redditMock.visibleToUser = 'someone-else'; // getPostsByUser fails: convention mismatch
+  await redisMock.set(
+    dailyPostClaimKey(NS, DAY0),
+    JSON.stringify({ challengeId: 'earth-circumference-v1', postId: null, at: NOW - DAILY_POST_STALE_MS - 1000 })
+  );
+  const result = await ensureDailyPostForUtcDay(DAY0, {
+    deps: mkDeps(redditMock, redisMock),
+    now: NOW,
+  });
+  assert.equal(result.status, 'created');
+  assert.equal(redditMock.submits.length, 1);
+});
+
+test('fresh claim (not stale) never triggers recovery or adoption', async () => {
+  const redisMock = new MockRedis();
+  const redditMock = new MockReddit();
+  redditMock.posts.set('t3_orphan', { challengeId: 'earth-circumference-v1' });
+  await redisMock.set(
+    dailyPostClaimKey(NS, DAY0),
+    JSON.stringify({
+      challengeId: 'earth-circumference-v1',
+      postId: null,
+      at: NOW - DAILY_POST_STALE_MS + 5000, // still fresh
+    })
+  );
+  const result = await ensureDailyPostForUtcDay(DAY0, {
+    deps: mkDeps(redditMock, redisMock),
+    now: NOW,
+  });
+  assert.equal(result.status, 'in-progress');
+  assert.equal(redditMock.submits.length, 0);
+});
+
+test('recorded postId that Reddit cannot serve → unreachable, never recreated automatically', async () => {
+  const redisMock = new MockRedis();
+  const redditMock = new MockReddit();
+  redditMock.failGetPostById = true;
+  await redisMock.set(
+    dailyPostClaimKey(NS, DAY0),
+    JSON.stringify({ challengeId: 'earth-circumference-v1', postId: 't3_gone', at: NOW })
+  );
+  const result = await ensureDailyPostForUtcDay(DAY0, {
+    deps: mkDeps(redditMock, redisMock),
+    now: NOW + 1000,
+  });
+  assert.equal(result.status, 'unreachable');
+  assert.equal(result.postId, 't3_gone');
+  assert.equal(redditMock.submits.length, 0);
+});

+  );
+  // The concurrent writer replaces the claim the moment our fenced flow
+  // reads it (before exec): emulate via a get() hook that swaps the claim
+  // once, exactly between the fence's read and exec.
+  const originalGet = redisMock.get.bind(redisMock);
+  let swapped = false;
+  (redisMock as unknown as { get: typeof redisMock.get }).get = async (k: string) => {
+    const v = await originalGet(k);
+    if (!swapped && k === key && v && v.includes('"pre-submit"') && v.includes(ownerA)) {
+      swapped = true;
+      // concurrent writer takes over right after our fence read
+      await originalGet(k); // no-op read
+      redisMock.strings.set(
+        key,
+        JSON.stringify({ phase: 'pre-submit', challengeId: CH0, day: DAY0, postId: null, at: NOW, owner: 'owner-B' })

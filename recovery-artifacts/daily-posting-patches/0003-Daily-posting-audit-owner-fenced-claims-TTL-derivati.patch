+/**
+ * OWNER-FENCED compare-and-set on the claim key. WATCH the key, re-read it
+ * through the plain client (store.ts-verified pattern), and only if the
+ * claim still shows the EXPECTED owner token AND phase, run MULTI +
+ * write(+TTL) + EXEC atomically. Outcomes:
+ *   'committed' — the guarded write applied.
+ *   'fenced'    — the claim no longer matches (changed under us): nothing
+ *                 was written; the caller must re-read and respond to the
+ *                 CURRENT state. Never overwrite, never release.
+ *   'aborted'   — WATCH abort (key changed between watch and exec): same
+ *                 handling as 'fenced'.
+ */
+async function fencedClaimWrite(
+  deps: DailyPostDeps,
+  key: string,
+  expect: { owner: string | undefined; phase: ClaimPhase },
+  next: Claim | 'DELETE',
+  ttlSeconds: number,
+  now: number
+): Promise<'committed' | 'fenced' | 'aborted'> {
+  const tx = await deps.redis.watch(key);
+  // Plain-client read between watch() and multi(): the SDK rejects pre-multi
+  // reads on the transaction client (store.ts-verified against 0.15.4).
+  const raw = await deps.redis.get(key);
+  // Day-agnostic parse: the fence compares owner+phase, and the caller
+  // already validated challengeId/day before invoking the fence.
+  const claim = raw ? parseClaim(raw, '') : null;
+  if (!claim || claim.owner !== expect.owner || claim.phase !== expect.phase) {
+    await tx.unwatch().catch(() => undefined);
+    return 'fenced';
+  }
+  await tx.multi();
+  if (next === 'DELETE') {
+    await tx.del(key);
+  } else {
+    await tx.set(key, JSON.stringify(next), {
+      expiration: new Date(now + ttlSeconds * 1000),
+    });
+  }
+  let execResult: unknown;
+  try {
+    execResult = await tx.exec();
+  } catch {
+    execResult = null; // SDK may surface abort as a rejection — treat as abort
+  }
+  if (execResult === null || execResult === undefined || !Array.isArray(execResult) || execResult.length === 0) {
+    return 'aborted';
+  }
+  return 'committed';
+}

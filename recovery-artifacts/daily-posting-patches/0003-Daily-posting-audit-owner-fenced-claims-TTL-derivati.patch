+test('FENCE: submitting→submitting transition aborts when the claim changed under the writer', async () => {
+  const redisMock = new MockRedis();
+  const reddit = new MockReddit();
+  // Simulate: worker holds a fresh pre-submit claim; ANOTHER worker deletes
+  // + re-claims between our WATCH-read and EXEC (exec aborts on change).
+  const deps = mkDeps(reddit, redisMock);

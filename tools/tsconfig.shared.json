{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "WebWorker",
      "ES2023"
    ],
    "outDir": "../dist/types/shared",
    "tsBuildInfoFile": "../dist/types/shared/tsconfig.tsbuildinfo",
    "rootDir": "../src/shared",
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true
  },
  "include": [
    "../src/shared/**/*"
  ],
  "exclude": [
    "../src/shared/**/*.test.ts"
  ]
}